{
  "$defs": {
    "ApprovalPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_fields": {
          "items": {
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Allowed Fields",
          "type": "array"
        },
        "allowed_origins": {
          "items": {
            "maxLength": 253,
            "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Allowed Origins",
          "type": "array"
        },
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "type",
                  "write",
                  "paste",
                  "fill"
                ],
                "type": "string"
              },
              "maxItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools"
        },
        "max_ttl_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Max Ttl Seconds",
          "type": "integer"
        },
        "max_uses": {
          "maximum": 10,
          "minimum": 1,
          "title": "Max Uses",
          "type": "integer"
        },
        "policy_id": {
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "title": "Policy Id",
          "type": "string"
        },
        "rules": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "policy_id",
        "allowed_origins",
        "allowed_fields",
        "max_ttl_seconds",
        "max_uses"
      ],
      "title": "ApprovalPolicy",
      "type": "object"
    },
    "Destination": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "title": "Field Id",
          "type": "string"
        },
        "origin": {
          "maxLength": 253,
          "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$",
          "title": "Origin",
          "type": "string"
        },
        "verified_by_runtime": {
          "title": "Verified By Runtime",
          "type": "boolean"
        }
      },
      "required": [
        "origin",
        "field_id",
        "verified_by_runtime"
      ],
      "title": "Destination",
      "type": "object"
    }
  },
  "$id": "https://plva.local/contracts/v1/approve-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "argument_path": {
      "maxLength": 64,
      "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*|\\[[0-9]+\\])*$",
      "title": "Argument Path",
      "type": "string"
    },
    "destination": {
      "anyOf": [
        {
          "$ref": "#/$defs/Destination"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pii_class": {
      "enum": [
        "NAME",
        "EMAIL",
        "PHONE",
        "ADDRESS",
        "DOB",
        "GOV_ID",
        "SSN",
        "BANK_ACCOUNT",
        "CARD_NUMBER",
        "CVC",
        "PASSWORD",
        "API_KEY",
        "AUTH_TOKEN",
        "PRIVATE_KEY",
        "SECRET"
      ],
      "title": "Pii Class",
      "type": "string"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "title": "Session Id",
      "type": "string"
    },
    "task_context": {
      "default": "",
      "maxLength": 1000,
      "title": "Task Context",
      "type": "string"
    },
    "token": {
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*_[1-9][0-9]*_[0-9a-f]{4}$",
      "title": "Token",
      "type": "string"
    },
    "tool_name": {
      "enum": [
        "type",
        "write",
        "paste",
        "fill"
      ],
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "request_id",
    "token",
    "pii_class",
    "tool_name",
    "argument_path"
  ],
  "title": "ApproveRequest",
  "type": "object"
}
