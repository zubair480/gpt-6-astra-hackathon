              "application/json": {
                "schema": {
                  "$ref": "./error-body.schema.json"
                }
              }
            },
            "description": "NOT_READY"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Bounded sort/select; returns input tokens only."
      }
    },
