{
  "$defs": {
    "ComputeItem": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*_[1-9][0-9]*_[0-9a-f]{4}$",
          "title": "Token",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "token",
        "value"
      ],
      "title": "ComputeItem",
      "type": "object"
    }
  },
  "$id": "https://plva.local/contracts/v1/compute-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "instruction": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Instruction",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ComputeItem"
      },
      "maxItems": 40,
      "minItems": 2,
      "title": "Items",
      "type": "array"
    },
    "operation": {
      "enum": [
        "sort",
        "select"
      ],
      "title": "Operation",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "select_count": {
      "anyOf": [
        {
          "maximum": 40,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Select Count"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "request_id",
    "operation",
    "instruction",
    "items"
  ],
  "title": "ComputeRequest",
  "type": "object"
}
