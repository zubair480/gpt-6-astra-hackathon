{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plva.local/contracts/v1/manifest.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "recording_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
    },
    "task": {
      "type": "string",
      "maxLength": 4000
    },
    "capture_mode": {
      "enum": [
        "screenshots_only",
        "enriched"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
        },
        "data_class": {
          "enum": [
            "synthetic",
            "sanitized"
          ]
        },
        "privacy_policy_version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
        }
      },
      "required": [
        "producer",
        "data_class",
        "privacy_policy_version"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 4000
        },
        "apps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4000
          },
          "maxItems": 256
        }
      },
      "required": [
        "kind",
        "apps"
      ],
      "additionalProperties": false
    },
    "events_file": {
      "type": "string",
      "maxLength": 4000
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frame_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
          },
          "path": {
            "type": "string",
            "maxLength": 4000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "frame_id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "outcome": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "passed",
            "failed",
            "cancelled"
          ]
        },
        "check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
          },
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "check_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "recording_id",
    "task",
    "capture_mode",
    "provenance",
    "environment",
    "events_file",
    "frames",
    "outcome"
  ],
  "additionalProperties": false
}
