# Copy to .env only if you need overrides. Never commit .env.
# Loopback bind address and port for the private reasoning service.
PLVA_PR_HOST=127.0.0.1
PLVA_PR_PORT=18555
# Directory where the per-launch bearer credential file is written (mode 0600).
PLVA_PR_RUNTIME_DIR=.plva-pr

# Agent demo only (src/plva_agent_demo). The cloud planner that sees redacted frames.
# Never share this key with the private reasoning service; it is read only by the demo runner.
OPENAI_API_KEY=
# Optional: pin the planner model id. Empty = pick the newest gpt-6/gpt-5 model on the account.
OPENAI_MODEL=
